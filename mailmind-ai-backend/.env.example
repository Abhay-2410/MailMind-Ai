# Application
APP_NAME=MailMind AI
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins — laptop + phone; LAN IP is added automatically at startup)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# Local Docker default:
DATABASE_URL=postgresql+asyncpg://mailmind:mailmind@localhost:5432/mailmind
#
# Supabase Postgres (recommended for hosted DB):
# - Use the direct Postgres connection string from Supabase
# - Include SSL params if Supabase provides them
# Example:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres?ssl=require

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (generate a strong random secret, min 32 chars)
# Avoid unescaped $ in secrets when using Docker Compose, or write $$ for a literal $.
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth token encryption (Fernet key)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# CSRF (min 32 chars)
# Avoid unescaped $ in secrets when using Docker Compose, or write $$ for a literal $.
CSRF_SECRET=change-me-to-a-long-random-csrf-secret

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# OpenRouter — https://openrouter.ai/keys (optional; used when selected in Settings)
OPENROUTER_API_KEY=

# Groq — https://console.groq.com/keys (default for AI assistant)
GROQ_API_KEY=
GROQ_ASSISTANT_MODEL=llama-3.1-8b-instant

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Application
APP_NAME=MailMind AI
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8020

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=postgresql+asyncpg://mailmind:mailmind@localhost:5432/mailmind

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (generate a strong random secret, min 32 chars)
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth token encryption (Fernet key)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# CSRF (min 32 chars)
CSRF_SECRET=change-me-to-a-long-random-csrf-secret

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKEND_PUBLIC_URL=http://localhost:8020
FRONTEND_URL=http://localhost:5173

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
